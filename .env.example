# Copy to .env and replace every value before starting services.
MYSQL_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-long-random-root-password
DATABASE_URL=mysql+pymysql://esg:replace-with-database-password@127.0.0.1:3306/terraledger
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173
AUTO_CREATE_SCHEMA=false
BOOTSTRAP_EMAIL=esg-admin@example.com
BOOTSTRAP_NAME=Group ESG Administrator
BOOTSTRAP_PASSWORD=replace-with-a-unique-password-of-at-least-14-characters
